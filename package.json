{
  "name": "seedshell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:apps": "node scripts/build-app-bundle.mjs",
    "build:boot-bundles": "node scripts/build-boot-bundles.mjs",
    "build": "npm run build:apps && npm run build:boot-bundles && npm run vendor",
    "relay": "seedrelay --stun 3478",
    "radio": "node node/radio.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "serve": "npm run vendor && npx --yes http-server browser -p 3000 -c-1",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "seedkernel-wasm": "file:../seedkernel/WASM",
    "seedrelay": "file:../seedrelay"
  },
  "devDependencies": {
    "assemblyscript": "0.28.14"
  }
}
